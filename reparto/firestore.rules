rules_version = '2';

// A la PaR multi-hogar: miembros e invitados por email acceden al hogar.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isAllowlisted() {
      return signedIn()
        && (
          !exists(/databases/$(database)/documents/config/allowlist)
          || request.auth.token.email.lower() in
            get(/databases/$(database)/documents/config/allowlist).data.emails
        );
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isMember(householdId) {
      return signedIn()
        && (
          request.auth.uid in householdData(householdId).memberUids
          || request.auth.token.email.lower() in householdData(householdId).memberEmails
        );
    }

    function isOwner(householdId) {
      return signedIn()
        && householdData(householdId).ownerUid == request.auth.uid;
    }

    function isOwnerOrAdmin(householdId) {
      return isOwner(householdId)
        || householdData(householdId).roles[request.auth.uid] == 'admin';
    }

    function validPlanSpaceCount(householdId, data) {
      let tier = householdData(householdId).planTier;
      let count = data.data.spaces.size();
      return (tier == 'personal' && count <= 1)
        || (tier == 'family' && count <= 3)
        || (tier == 'plus' && count <= 99);
    }

    match /config/allowlist {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /households/{householdId} {
      allow create: if isAllowlisted()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids
        && request.auth.token.email.lower() in request.resource.data.memberEmails;
      allow read: if signedIn()
        && (
          request.auth.uid in resource.data.memberUids
          || request.auth.token.email.lower() in resource.data.memberEmails
        );

      // El owner administra nombre, plan e invitaciones.
      // Un invitado solo puede agregar su propio UID al ingresar por primera vez.
      allow update: if signedIn() && (
        isOwner(householdId)
        || (
          request.auth.token.email.lower() in resource.data.memberEmails
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberUids', 'memberUidByEmail', 'memberNamesByEmail', 'roles', 'updatedAt'])
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.roles[request.auth.uid] == 'member'
        )
      );
      allow delete: if isOwner(householdId);

      match /state/{documentId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && validPlanSpaceCount(householdId, request.resource.data);
        allow delete: if isOwnerOrAdmin(householdId);
      }

      // La información personal nunca comparte documento con el hogar.
      match /private/{uid} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == uid
          && isMember(householdId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
