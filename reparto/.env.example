# Copiá este archivo a `.env` y completá los valores.
# NUNCA subas `.env` a GitHub (ya está en .gitignore).

# --- Firebase (Console → Configuración del proyecto → Tus apps → SDK) ---
VITE_FIREBASE_API_KEY=PEGAR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=PEGAR_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PEGAR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=PEGAR_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=PEGAR_SENDER_ID
VITE_FIREBASE_APP_ID=PEGAR_APP_ID

# Opcional: tu Gmail de operador, separado por comas.
# Si está definido, esa cuenta puede asignar el plan del hogar que está viendo.
# Los demás hogares se cambian en Firebase Console → households/{id} → planTier.
VITE_ADMIN_EMAILS=tu-gmail@gmail.com
